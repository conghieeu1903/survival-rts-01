{
  "description": "Design tokens wireframe xám sáng, lấy từ BattleUiKit.cs. Màu hex, kích thước px.",
  "colors": {
    "screen": "#E8E8E8",
    "world": "#C6C6C6",
    "panel": "#FAFAFA",
    "row": "#DADADA",
    "border": "#808080",
    "separator": "#C0C0C0",
    "ink": "#262626",
    "dim": "#6C6C6C",
    "primary": "#505050",
    "primaryText": "#FAFAFA",
    "progressFill": "#686868",
    "backdrop": { "color": "#262626", "opacity": 0.45 },
    "button": {
      "normal": { "fill": "#DADADA", "stroke": "#808080" },
      "hover": { "fill": "#C6C6C6", "stroke": "#505050" },
      "pressed": { "fill": "#A8A8A8", "stroke": "#262626" },
      "disabled": { "fill": "#E3E3E3", "stroke": "#C0C0C0" }
    },
    "primaryButton": {
      "normal": { "fill": "#505050", "stroke": "#262626" },
      "hover": { "fill": "#3D3D3D", "stroke": "#262626" },
      "pressed": { "fill": "#262626", "stroke": "#262626" },
      "disabled": { "fill": "#9E9E9E", "stroke": "#9E9E9E" }
    },
    "legacyDark": {
      "panel": { "color": "#242424", "opacity": 0.95 },
      "card": "#383838",
      "track": "#1A1A1A",
      "border": "#7A7A7A",
      "text": "#F5F5F5",
      "textDim": "#C7C7C7",
      "accent": "#E6E6E6",
      "darkText": "#141414"
    }
  },
  "stroke": { "width": 2, "align": "INSIDE" },
  "cornerRadius": { "panel": 6, "control": 4 },
  "font": { "family": "Liberation Sans", "figmaFallback": "Inter", "sizes": [14, 16, 18, 20, 22, 24, 26, 28, 30, 32, 44] },
  "frames": {
    "main": { "width": 1920, "height": 1080 },
    "legacyOffline": { "width": 1440, "height": 810 }
  },
  "components": {
    "bigMenuButton": { "height": 56, "fontSize": 24 },
    "button": { "height": 48, "footerHeight": 52, "fontSize": 20 },
    "input": { "height": 48, "textPadding": 12 },
    "settingRow": { "height": 56, "lineHeight": 2, "titleMinWidth": 360 },
    "slider": { "width": 320, "height": 32, "trackHeight": 14, "handle": [20, 32], "valueLabelWidth": 90 },
    "toggle": { "width": 120, "height": 40 },
    "choice": { "arrowButton": [44, 40], "valueWidth": 220 },
    "tab": { "width": 180, "height": 44, "gap": 8 },
    "teamSwatch": { "lobby": 30, "hud": 20, "result": 24 },
    "dialog": { "width": 560, "padding": 20, "gap": 20 }
  },
  "teamColors": ["#5A8CFF", "#FF6659", "#66E673", "#FFD94D"]
}
