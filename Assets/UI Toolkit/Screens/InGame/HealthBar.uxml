<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Style src="HealthBar.uss" />
  <ui:VisualElement name="healthRoot" class="health-root" picking-mode="Ignore">
    <ui:VisualElement name="healthBar" class="health-container hidden" picking-mode="Ignore">
      <ui:Label name="statusLabel" text="" class="health-status hidden" picking-mode="Ignore" />
      <ui:VisualElement name="barTrack" class="health-bar" picking-mode="Ignore">
        <ui:VisualElement name="fill" class="health-fill" picking-mode="Ignore" />
        <ui:Label name="valueLabel" text="0 / 0" class="health-value" picking-mode="Ignore" />
      </ui:VisualElement>
      <ui:VisualElement name="workerPanel" class="worker-panel hidden">
        <ui:Button name="removeWorkerButton" text="-" class="worker-btn" />
        <ui:Label name="workerLabel" text="Thợ: 0/3" class="worker-label" picking-mode="Ignore" />
        <ui:Button name="addWorkerButton" text="+ Thợ" class="worker-btn worker-btn--add" />
      </ui:VisualElement>
      <ui:VisualElement name="demolishPanel" class="demolish-panel hidden">
        <ui:Button name="demolishButton" text="Tháo dỡ" class="worker-btn worker-btn--danger" />
        <ui:Label name="demolishConfirmLabel" text="Phá (2.5s)?" class="demolish-label hidden" picking-mode="Ignore" />
        <ui:Button name="confirmDemolishBtn" text="Xác nhận phá" class="worker-btn worker-btn--danger-confirm hidden" />
        <ui:Button name="cancelDemolishBtn" text="Hủy" class="worker-btn hidden" />
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
