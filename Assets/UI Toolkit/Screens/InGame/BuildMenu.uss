:root {
  --color-panel: rgba(16, 20, 16, 0.88);
  --color-card: #1c231c;
  --color-card-hover: #283228;
  --color-border: #4a4128;
  --color-accent: #e0a33a;
  --color-text: #e8ece6;
  --color-text-dim: #8c978c;
  --color-key: #0b0f0b;
  --color-footprint: #6f8f5a;
  --color-danger: #e0644a;
}

.build-root {
  flex-grow: 1;
  justify-content: flex-end;
  align-items: center;
  padding-bottom: 20px;
}

.resource-hud {
  position: absolute;
  top: 16px;
  right: 20px;
  flex-direction: row;
  align-items: center;
}

.resource-badge {
  flex-direction: row;
  align-items: center;
  min-width: 112px;
  margin-left: 10px;
  padding: 6px 12px 6px 8px;
  background-color: var(--color-panel);
  border-width: 1px;
  border-color: var(--color-border);
  border-radius: 6px;
}

.resource-icon {
  width: 32px;
  height: 32px;
  margin-right: 8px;
  -unity-background-scale-mode: scale-to-fit;
}

.resource-icon--pop {
  background-image: url("/Assets/Arts/Textures/Icon_Population.png");
}

.resource-icon--wood {
  background-image: url("/Assets/Arts/Textures/Icon_Wood.png");
}

.resource-icon--stone {
  background-image: url("/Assets/Arts/Textures/Icon_Stone.png");
}

.resource-icon--gold {
  background-image: url("/Assets/Arts/Textures/Icon_Gold.png");
}

.resource-icon--food {
  background-image: url("/Assets/Arts/Textures/Icon_Food.png");
}

.resource-icon--iron {
  background-image: url("/Assets/Arts/Textures/Icon_Iron.png");
}

.resource-info {
  flex-direction: column;
  justify-content: center;
}

.resource-label {
  font-size: 10px;
  letter-spacing: 1px;
  -unity-font-style: bold;
  color: var(--color-text-dim);
  margin-bottom: 1px;
}

.resource-value {
  font-size: 16px;
  -unity-font-style: bold;
  color: var(--color-text);
}

.minimap-panel {
  position: absolute;
  left: 20px;
  bottom: 20px;
  padding: 6px;
  background-color: var(--color-panel);
  border-width: 2px;
  border-color: var(--color-border);
  border-radius: 6px;
}

.minimap-header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4px;
  padding: 0 2px;
}

.minimap-title {
  font-size: 10px;
  letter-spacing: 2px;
  -unity-font-style: bold;
  color: var(--color-accent);
}

.minimap-sub {
  font-size: 9px;
  color: var(--color-text-dim);
}

.minimap-canvas {
  width: 180px;
  height: 180px;
  background-color: #1a2418;
  border-width: 1px;
  border-color: #36301d;
  border-radius: 3px;
  -unity-background-scale-mode: stretch-to-fill;
}

.build-panel {
  min-width: 440px;
  padding: 8px 12px 12px 12px;
  background-color: var(--color-panel);
  border-width: 1px;
  border-color: var(--color-border);
  border-radius: 6px;
}

.build-header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.build-title {
  font-size: 13px;
  letter-spacing: 3px;
  -unity-font-style: bold;
  color: var(--color-accent);
}

.build-hint {
  margin-left: 24px;
  font-size: 12px;
  color: var(--color-text-dim);
}

.build-tabs {
  flex-direction: row;
  margin-bottom: 8px;
}

.build-tab {
  flex-direction: row;
  align-items: center;
  margin: 0 6px 0 0;
  padding: 4px 10px;
  background-color: var(--color-card);
  border-width: 1px;
  border-color: var(--color-border);
  border-radius: 4px;
  font-size: 12px;
  color: var(--color-text-dim);
  transition-duration: 0.12s;
}

.build-tab:hover {
  color: var(--color-text);
  border-color: var(--color-accent);
}

.build-tab--active {
  background-color: var(--color-accent);
  border-color: var(--color-accent);
  color: var(--color-key);
  -unity-font-style: bold;
}

.build-tab--active:hover {
  color: var(--color-key);
}

.build-tab-count {
  margin-left: 6px;
  padding: 0 5px;
  background-color: var(--color-key);
  border-radius: 3px;
  font-size: 11px;
  -unity-font-style: bold;
  color: var(--color-accent);
}

.build-list {
  flex-direction: row;
}

.build-empty {
  height: 108px;
  -unity-text-align: middle-center;
  font-size: 12px;
  color: var(--color-text-dim);
}

.build-placing {
  flex-direction: row;
  align-items: center;
  margin-top: 8px;
  padding-top: 8px;
  border-top-width: 1px;
  border-color: var(--color-border);
}

.build-placing-label {
  flex-grow: 1;
  font-size: 12px;
  color: var(--color-text);
}

.build-action {
  margin: 0 0 0 6px;
  padding: 4px 12px;
  background-color: var(--color-card);
  border-width: 1px;
  border-color: var(--color-border);
  border-radius: 4px;
  font-size: 12px;
  color: var(--color-text);
  transition-duration: 0.12s;
}

.build-action:hover {
  background-color: var(--color-card-hover);
  border-color: var(--color-accent);
}

.build-tab--demolish {
  margin-left: auto;
  margin-right: 0;
  border-color: var(--color-danger);
  color: var(--color-danger);
  -unity-font-style: bold;
}

.build-tab--demolish:hover {
  background-color: rgba(224, 100, 74, 0.18);
  border-color: var(--color-danger);
  color: var(--color-text);
}

.build-tab--demolish-active {
  background-color: var(--color-danger);
  border-color: var(--color-danger);
  color: var(--color-key);
  -unity-font-style: bold;
}

.build-tab--demolish-active:hover {
  background-color: var(--color-danger);
  color: var(--color-key);
}

.build-action--danger {
  background-color: var(--color-danger);
  border-color: var(--color-danger);
  color: var(--color-key);
  -unity-font-style: bold;
}

.build-action--danger:hover {
  background-color: #f0765c;
  border-color: #f0765c;
  color: var(--color-key);
}

.build-action--cancel:hover {
  border-color: var(--color-danger);
  color: var(--color-danger);
}

.build-hidden {
  display: none;
}

.build-card {
  width: 102px;
  height: 118px;
  margin: 0 8px 0 0;
  padding: 5px;
  align-items: center;
  background-color: var(--color-card);
  border-width: 1px;
  border-color: var(--color-border);
  border-radius: 4px;
  transition-duration: 0.12s;
}

.build-card:hover {
  background-color: var(--color-card-hover);
  border-color: var(--color-accent);
}

.build-card--selected {
  background-color: var(--color-card-hover);
  border-color: var(--color-accent);
  border-width: 2px;
  padding: 4px;
}

.build-card--disabled {
  opacity: 0.55;
  border-color: #322c20;
}

.build-card--disabled:hover {
  background-color: var(--color-card);
  border-color: var(--color-danger);
}

.build-card-preview {
  width: 72px;
  height: 48px;
  justify-content: center;
  align-items: center;
}

.build-card-footprint {
  background-color: var(--color-footprint);
  border-width: 1px;
  border-color: var(--color-text);
}

.build-card-name {
  margin-top: 4px;
  font-size: 12px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--color-text);
}

.build-card-size {
  font-size: 10px;
  color: var(--color-text-dim);
}

.build-card-cost {
  margin-top: 2px;
  font-size: 11px;
  -unity-font-style: bold;
  color: var(--color-accent);
}

.build-card-cost--lack {
  color: var(--color-danger);
}

.fp-w-1 { width: 12px; }
.fp-w-2 { width: 24px; }
.fp-w-3 { width: 36px; }
.fp-w-4 { width: 48px; }
.fp-w-5 { width: 60px; }
.fp-w-6 { width: 72px; }

.fp-d-1 { height: 12px; }
.fp-d-2 { height: 24px; }
.fp-d-3 { height: 36px; }
.fp-d-4 { height: 48px; }
.fp-d-5 { height: 60px; }
.fp-d-6 { height: 72px; }
