:root {
  --color-bg: #0f1411;
  --color-bg-panel: #182019;
  --color-accent: #e0a33a;
  --color-text: #e8ece6;
  --color-text-dim: #8c978c;
  --color-track: #263027;
  --spacing-sm: 8px;
  --spacing-md: 16px;
  --spacing-lg: 32px;
}

.loading-screen {
  flex-grow: 1;
  justify-content: center;
  align-items: center;
  background-color: var(--color-bg);
}

.loading-center {
  align-items: center;
}

.loading-title {
  font-size: 64px;
  -unity-font-style: bold;
  letter-spacing: 12px;
  color: var(--color-text);
}

.loading-subtitle {
  margin-top: var(--spacing-sm);
  font-size: 18px;
  letter-spacing: 6px;
  color: var(--color-accent);
}

.loading-divider {
  width: 120px;
  height: 2px;
  margin-top: var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
  background-color: var(--color-accent);
}

.loading-footer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: var(--spacing-lg) 10% var(--spacing-lg) 10%;
  background-color: var(--color-bg-panel);
  border-top-width: 1px;
  border-top-color: var(--color-track);
}

.loading-status-row {
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: var(--spacing-sm);
}

.loading-status {
  font-size: 16px;
  color: var(--color-text);
}

.loading-percent {
  font-size: 16px;
  -unity-font-style: bold;
  color: var(--color-accent);
}

.loading-progress {
  height: 10px;
  margin: 0;
}

.loading-progress .unity-progress-bar__container {
  flex-grow: 1;
}

.loading-progress .unity-progress-bar__background {
  flex-grow: 1;
  border-width: 0;
  border-radius: 5px;
  background-color: var(--color-track);
}

.loading-progress .unity-progress-bar__progress {
  background-color: var(--color-accent);
  border-radius: 5px;
}

.loading-progress .unity-progress-bar__title {
  display: none;
}

.loading-tip {
  margin-top: var(--spacing-md);
  font-size: 14px;
  white-space: normal;
  color: var(--color-text-dim);
}
