<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Style src="BuildMenu.uss" />
  <ui:VisualElement name="buildMenuRoot" class="build-root" picking-mode="Ignore">
    <ui:VisualElement name="resourceHud" class="resource-hud">
      <ui:VisualElement name="woodBadge" class="resource-badge">
        <ui:VisualElement name="woodIcon" class="resource-icon resource-icon--wood" />
        <ui:VisualElement class="resource-info">
          <ui:Label text="GỖ" class="resource-label" />
          <ui:Label name="woodValueLabel" text="0" class="resource-value" />
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement name="stoneBadge" class="resource-badge">
        <ui:VisualElement name="stoneIcon" class="resource-icon resource-icon--stone" />
        <ui:VisualElement class="resource-info">
          <ui:Label text="ĐÁ" class="resource-label" />
          <ui:Label name="stoneValueLabel" text="0" class="resource-value" />
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="buildPanel" class="build-panel">
      <ui:VisualElement name="headerRow" class="build-header">
        <ui:Label name="titleLabel" text="XÂY DỰNG" class="build-title" />
        <ui:Label name="popLabel" text="Dân tự do: 0 / 0  ·  Thợ xây: 0" class="build-hint" />
        <ui:Label name="hintLabel" text="Chuột trái đặt  ·  Chuột phải hủy" class="build-hint" />
      </ui:VisualElement>
      <ui:VisualElement name="tabRow" class="build-tabs" />
      <ui:VisualElement name="buildList" class="build-list" />
      <ui:Label name="emptyLabel" text="Chưa có công trình nào trong nhóm này" class="build-empty build-hidden" />
      <ui:VisualElement name="placingBar" class="build-placing build-hidden">
        <ui:Label name="placingLabel" text="Đang đặt" class="build-placing-label" />
        <ui:Button name="rotateButton" text="Xoay 90°" class="build-action" />
        <ui:Button name="cancelButton" text="Hủy" class="build-action build-action--cancel" />
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
