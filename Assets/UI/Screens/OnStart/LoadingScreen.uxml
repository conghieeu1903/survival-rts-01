<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Style src="LoadingScreen.uss" />
  <ui:VisualElement name="loadingScreen" class="loading-screen">
    <ui:VisualElement name="loadingCenter" class="loading-center">
      <ui:Label name="titleLabel" text="SURVIVAL RTS" class="loading-title" />
      <ui:Label name="subtitleLabel" text="BUILD · GATHER · SURVIVE" class="loading-subtitle" />
      <ui:VisualElement name="divider" class="loading-divider" />
    </ui:VisualElement>
    <ui:VisualElement name="loadingFooter" class="loading-footer">
      <ui:VisualElement name="statusRow" class="loading-status-row">
        <ui:Label name="statusLabel" text="Đang tải bản đồ..." class="loading-status" />
        <ui:Label name="percentLabel" text="45%" class="loading-percent" />
      </ui:VisualElement>
      <ui:ProgressBar name="progressBar" value="45" class="loading-progress" />
      <ui:Label name="tipLabel" text="Mẹo: Thu thập tài nguyên trước khi đêm xuống để xây dựng phòng thủ." class="loading-tip" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
